# Environment contract — docs/CONFIGURATION.md, docs/architecture/DEPLOYMENT_ENVIRONMENTS.md
#
# Local:      cp .env.example .env && docker compose up -d --build  (bundled Postgres: DB_HOST=db in compose)
# Staging:    cp .env.example .env — apply staging: hints; docker compose -f docker-compose.staging.yml up -d --build
# Production: cp .env.example .env — apply production: hints; docker compose -f docker-compose.external-db.yml up -d --build

# =============================================================================
# Core Django
# =============================================================================

SECRET_KEY=replace-me
APP_ENV=local  # staging: staging | production: production
DEBUG=1  # staging: 0 | production: 0
ALLOWED_HOSTS=localhost,127.0.0.1  # staging/production: +your API/SPA hostnames
TIME_ZONE=America/Chicago

# =============================================================================
# Database
# =============================================================================
# Local / staging (docker-compose.staging.yml): compose sets DB_HOST=db in app containers.
# Production: docker-compose.external-db.yml — set DB_HOST to RDS endpoint in .env.

DB_ENGINE=django.db.backends.postgresql
DB_NAME=myproject  # staging: often myproject or myproject_staging
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=600

# =============================================================================
# Security & CORS
# =============================================================================

CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8000,http://localhost:8000  # staging/production: +https origins
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5173,http://localhost:5173

SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https
SECURE_SSL_REDIRECT=False  # production HTTPS: True
SESSION_COOKIE_SECURE=False  # production HTTPS: True
CSRF_COOKIE_SECURE=False  # production HTTPS: True

# =============================================================================
# Static, media & storage
# =============================================================================

USE_S3_STORAGE=False
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=

# =============================================================================
# URLs & email
# =============================================================================

FRONTEND_URL=http://localhost:3000  # staging: https://app.staging.example | production: https://app.example.com
BACKEND_URL=http://localhost:8000  # staging: https://api.staging.example | production: https://api.example.com
DEFAULT_FROM_EMAIL=noreply@example.com
EMAIL_RECIPIENTS_OVERRIDE=  # staging: qa@example.com | production: empty
# EMAIL_BACKEND=django_jt.backends.email.gmail.GmailBackend
# EMAIL_BACKEND=django_jt.backends.email.graph.GraphEmailBackend

MS_GRAPH_CLIENT_ID=
MS_GRAPH_TENANT_ID=

# =============================================================================
# Redis / Celery / cache / Channels
# =============================================================================

REDIS_URL=redis://localhost:6379  # docker compose stacks: redis://redis:6379

CELERY_TASK_IGNORE_RESULT=true
CHANNELS_ENABLED=false
CELERY_WORKER_PREFETCH_MULTIPLIER=1

# =============================================================================
# Logging
# =============================================================================

LOG_LEVEL=INFO

# =============================================================================
# Integrations
# =============================================================================

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# =============================================================================
# Optional / QA
# =============================================================================

DEMO_ENABLED=true  # production: false

# =============================================================================
# Docker / runtime
# =============================================================================

COMPOSE_PROJECT_NAME=myproject  # staging: myproject-staging (see docker-compose.staging.yml)
HOST_FORWARD_APP_PORT=8000  # use a different port when staging + production share one host
HOST_BIND_ADDRESS=127.0.0.1
DB_MEM_LIMIT=2g
REDIS_MEM_LIMIT=512m
WEB_MEM_LIMIT=2g
WORKER_MEM_LIMIT=4g
BEAT_MEM_LIMIT=1g
WEB_CONCURRENCY=1
GUNICORN_TIMEOUT=360
GUNICORN_GRACEFUL_TIMEOUT=120
GUNICORN_KEEPALIVE=10
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=100
UVICORN_KEEPALIVE_TIMEOUT=10
CELERY_WORKER_CONCURRENCY=1
CELERY_WORKER_MAX_TASKS_PER_CHILD=20
