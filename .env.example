# Copy to .env — see README for Docker setup

# Core Django
SECRET_KEY=replace-me
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS & CSRF
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:8050,http://localhost:8050

# Database (docker-compose overrides DB_HOST=db inside the compose network)
# Outside Docker: DB_HOST=localhost, DB_PORT=5432
DB_ENGINE=django.db.backends.postgresql
DB_NAME=myproject
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Redis (base URL only — no /0 suffix; settings assign DB indexes)
# /0 Celery broker  /1 Celery results  /2 Django cache  /3 Channels (if enabled)
# Docker Compose: REDIS_URL=redis://redis:6379
REDIS_URL=redis://localhost:6379

# Optional per-role overrides (full URLs):
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/1
# CACHE_REDIS_URL=redis://localhost:6379/2
# CHANNELS_REDIS_URL=redis://localhost:6379/3

CELERY_TASK_IGNORE_RESULT=true
CHANNELS_ENABLED=false

# Security (local dev)
SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https

# AWS S3 (production static/media — optional in dev)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-2

# Email
DEFAULT_FROM_EMAIL=noreply@example.com

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI Chatbot Configuration (Optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Docker
COMPOSE_PROJECT_NAME=myproject
HOST_FORWARD_APP_PORT=8050
WEB_CONCURRENCY=1
CELERY_WORKER_CONCURRENCY=1
CELERY_WORKER_MAX_TASKS_PER_CHILD=10
