# Django Configuration
DEBUG=True
SECRET_KEY=django-insecure-change-this-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration
DEF_DB_ENGINE=django.db.backends.postgresql
DEF_DB_NAME=django_db
DEF_DB_USER=postgres
DEF_DB_PASSWORD=postgres
DEF_DB_HOST=localhost
DEF_DB_PORT=5432

# Email Configuration
DEFAULT_FROM_EMAIL=noreply@example.com

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/0

# AWS S3 Configuration (Production only)
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-2

# Security Configuration
SECURE_PROXY_SSL_HEADER=https
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://localhost:8080,http://127.0.0.1:8000,http://127.0.0.1:8080
