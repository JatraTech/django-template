# Copy to .env — see README for Docker setup

# =============================================================================
# Core Django
# =============================================================================
# Production: DEBUG=0 and set ALLOWED_HOSTS (DEBUG=1 allows all hosts in settings).

SECRET_KEY=replace-me
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# =============================================================================
# Database
# =============================================================================
# Docker Compose sets DB_HOST=db inside the compose network.
# Outside Docker: DB_HOST=localhost, DB_PORT=5432

DB_ENGINE=django.db.backends.postgresql
DB_NAME=myproject
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
# Production behind PgBouncer may use a lower value (e.g. 60).
DB_CONN_MAX_AGE=600

# =============================================================================
# Internationalization
# =============================================================================

TIME_ZONE=America/Chicago

# =============================================================================
# Security & CORS
# =============================================================================
# If HOST_FORWARD_APP_PORT is not 8000 (e.g. staging 8001 on the same host), add
# http://127.0.0.1:<port> and http://localhost:<port> to both lists below.

CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8000,http://localhost:8000
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5173,http://localhost:5173

# =============================================================================
# Static, media & storage
# =============================================================================
# Local filesystem by default. Set True only when AWS/B2 credentials are configured.
# You may also place AWS_* in .secrets/aws.secret (loaded at startup).

USE_S3_STORAGE=False
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=

# =============================================================================
# URLs & email
# =============================================================================

FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
DEFAULT_FROM_EMAIL=noreply@example.com
EMAIL_RECIPIENTS_OVERRIDE=
# Outbound mail backend (default: console — no real sends). Examples:
# EMAIL_BACKEND=app.utils.backends.email.gmail.GmailBackend
# Gmail OAuth (after `python manage.py gmail_oauth_token`): .secrets/google_client_secret.json, .secrets/google_token.json
# EMAIL_BACKEND=app.utils.backends.email.graph.GraphEmailBackend
# Comma-separated; when set, Gmail and Graph backends send only to these addresses (staging safety).

# Microsoft Graph (delegated). Run `python manage.py graph_auth` once to sign in;
# re-run when silent token refresh fails. Token cache: .secrets/ms_graph_msal_cache.json
MS_GRAPH_CLIENT_ID=
MS_GRAPH_TENANT_ID=

# =============================================================================
# Redis / Celery / cache / Channels
# =============================================================================
# Base URL only — no /0 suffix; settings assign DB indexes:
# /0 Celery broker  /1 Celery results  /2 Django cache  /3 Channels (if enabled)
# Docker Compose: REDIS_URL=redis://redis:6379

REDIS_URL=redis://localhost:6379

# Optional per-role overrides (full URLs):
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/1
# CACHE_REDIS_URL=redis://localhost:6379/2
# CHANNELS_REDIS_URL=redis://localhost:6379/3

CELERY_TASK_IGNORE_RESULT=true
# Requires: uv sync --group channels and README "Optional: Django Channels" steps. Leave false otherwise.
CHANNELS_ENABLED=false
CELERY_WORKER_PREFETCH_MULTIPLIER=1

# =============================================================================
# AI chatbot (optional)
# =============================================================================
# Not used by the default template; wire when adding a chatbot app.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# =============================================================================
# Docker / runtime
# =============================================================================

COMPOSE_PROJECT_NAME=myproject
HOST_FORWARD_APP_PORT=8000
HOST_BIND_ADDRESS=127.0.0.1
# Optional Linux volume permissions (docker build args):
# APP_UID=1000
# APP_GID=1000
# Optional container memory caps (docker compose mem_limit)
DB_MEM_LIMIT=2g
REDIS_MEM_LIMIT=512m
WEB_MEM_LIMIT=2g
WORKER_MEM_LIMIT=4g
BEAT_MEM_LIMIT=1g
WEB_CONCURRENCY=1
GUNICORN_TIMEOUT=360
GUNICORN_GRACEFUL_TIMEOUT=120
GUNICORN_KEEPALIVE=10
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=100
# Uvicorn only (when using the commented ASGI command in docker-compose.yml)
UVICORN_KEEPALIVE_TIMEOUT=10
CELERY_WORKER_CONCURRENCY=1
CELERY_WORKER_MAX_TASKS_PER_CHILD=20
