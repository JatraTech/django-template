*.dump
*.backup

# Temporary Files
*.bak
*.tmp
*.temp
*.cache

# Frontend / CSS Tools
.sass-cache/
.stylelintcache

# Misc
*.pid
*.seed
*.pid.lock

# Local secrets (Compose mount: ./.secrets → /app/.secrets)
.secrets/*
!.secrets

# Celery beat (worker container)
celerybeat-schedule*
celerybeat.pid
