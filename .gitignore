__pycache__/
*.py[cod]
*$py.class
*.so
.Python

.venv/
venv/
env/
ENV/

*.egg
*.egg-info/
.eggs/
dist/
build/
*.manifest
*.spec

pip-log.txt
pip-delete-this-directory.txt
